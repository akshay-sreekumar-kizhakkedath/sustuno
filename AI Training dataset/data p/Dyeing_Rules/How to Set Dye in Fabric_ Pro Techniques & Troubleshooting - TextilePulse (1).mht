.footer-brand .logo-mark { background: linear-gradient(135deg, var(--plum), var(--rose)); width: 28px; height: 28px; color: var(--gold); border-radius: 5px; justify-content: center; align-items: center; font-size: 0.75rem; font-weight: 700; display: flex; }

