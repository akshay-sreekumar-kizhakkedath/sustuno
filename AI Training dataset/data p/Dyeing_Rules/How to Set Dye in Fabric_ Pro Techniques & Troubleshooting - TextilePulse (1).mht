@charset "utf-8";

.article-content { font-family: "Work Sans", sans-serif; line-height: 1.8; color: rgb(45, 16, 40); font-size: 1.05rem; }

.article-content h2 { font-family: "Cormorant Garamond", serif; font-size: 1.6rem; color: rgb(74, 25, 66); margin-top: 2rem; margin-bottom: 0.8rem; padding-bottom: 0.4rem; border-bottom: 2px solid rgb(194, 24, 91); }

.article-content h3 { font-family: "Cormorant Garamond", serif; font-size: 1.3rem; color: rgb(45, 16, 40); margin-top: 1.5rem; margin-bottom: 0.6rem; }

.article-content h4 { font-family: "Cormorant Garamond", serif; font-size: 1.1rem; color: rgb(74, 25, 66); margin-top: 1.2rem; margin-bottom: 0.5rem; }

.article-content p { margin-bottom: 1.2rem; font-family: "Work Sans", sans-serif; }

.article-content a { color: rgb(194, 24, 91); text-decoration: underline; text-underline-offset: 3px; }

.article-content a:hover { color: rgb(74, 25, 66); }

.article-content ul, .article-content ol { margin-bottom: 1.2rem; padding-left: 1.5rem; }

.article-content li { margin-bottom: 0.5rem; font-family: "Work Sans", sans-serif; }

.article-content strong { font-weight: 700; color: rgb(45, 16, 40); }

.article-content blockquote { border-left: 4px solid rgb(194, 24, 91); padding: 1rem 1.5rem; margin: 1.5rem 0px; background: rgb(255, 248, 225); border-radius: 0px 8px 8px 0px; font-family: "Work Sans", sans-serif; color: rgb(107, 76, 107); }

.article-content table { width: 100%; border-collapse: collapse; margin: 1.5rem 0px; font-size: 0.92rem; }

.article-content th { background: rgb(74, 25, 66); color: rgb(255, 255, 255); padding: 0.75rem 1rem; text-align: left; font-family: "Work Sans", sans-serif; font-weight: 600; }

.article-content td { padding: 0.75rem 1rem; border-bottom: 1px solid rgb(229, 231, 235); font-family: "Work Sans", sans-serif; }

.article-content tr:hover td { background: rgb(255, 248, 225); }

.article-content img { max-width: 100%; height: auto; border-radius: 12px; margin: 1.5rem 0px; }

.article-content code { background: rgb(255, 248, 225); padding: 0.15rem 0.4rem; border-radius: 4px; font-size: 0.9em; color: rgb(74, 25, 66); }
