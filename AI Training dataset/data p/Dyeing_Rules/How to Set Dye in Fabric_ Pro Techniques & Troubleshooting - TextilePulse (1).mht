.breadcrumb-current { color: var(--text-mid); }

.category-page { max-width: 1200px; margin: 0px auto; padding: 1rem clamp(1rem, 5vw, 4rem) 4rem; }

.category-banner { text-align: center; margin-bottom: 2.5rem; padding: 2rem 0px; }

.category-banner h1 { color: var(--plum-dark); margin-bottom: 0.5rem; font-family: "Cormorant Garamond", serif; font-size: clamp(2rem, 4vw, 2.8rem); font-weight: 700; }

.category-banner p { color: var(--text-mid); max-width: 600px; margin: 0px auto; font-size: 1.05rem; }

.category-banner .article-count { background: var(--gold-light); color: var(--plum); border-radius: 100px; margin-top: 1rem; padding: 0.3rem 1rem; font-size: 0.8rem; font-weight: 600; display: inline-block; }

.article-grid { grid-template-columns: repeat(3, 1fr); gap: 1.5rem; display: grid; }

.article-card { color: inherit; background: rgb(255, 255, 255); border: 1px solid rgba(74, 25, 66, 0.06); border-radius: 12px; text-decoration: none; transition: 0.3s; display: block; overflow: hidden; box-shadow: rgba(74, 25, 66, 0.04) 0px 2px 12px; }

