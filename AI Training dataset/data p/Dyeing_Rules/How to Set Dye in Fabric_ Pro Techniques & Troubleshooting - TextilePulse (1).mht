.card-img { object-fit: cover; width: 100%; height: 200px; transition: transform 0.4s; display: block; }

.article-card:hover .card-img { transform: scale(1.03); }

.card-img-placeholder { background: linear-gradient(135deg, rgba(74, 25, 66, 0.05), rgba(194, 24, 91, 0.05)); width: 100%; height: 200px; }

.card-body { padding: 1.2rem 1.25rem; }

.card-category { color: var(--rose); text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 0.5rem; font-size: 0.65rem; font-weight: 700; display: inline-block; }

.card-body h3 { color: var(--plum-dark); margin-bottom: 0.5rem; font-family: "Cormorant Garamond", serif; font-size: 1.15rem; font-weight: 700; line-height: 1.3; }

.card-body p { color: var(--text-mid); -webkit-line-clamp: 2; -webkit-box-orient: vertical; font-size: 0.82rem; line-height: 1.55; display: -webkit-box; overflow: hidden; }

.card-meta { color: var(--text-mid); justify-content: space-between; align-items: center; margin-top: 0.8rem; font-size: 0.72rem; display: flex; }

.card-author { color: var(--plum); font-weight: 600; }

.pagination { justify-content: center; align-items: center; gap: 1rem; margin-top: 3rem; padding-bottom: 1rem; display: flex; }

.pagination-info { color: var(--text-mid); font-size: 0.82rem; }

.pagination-btn { background: var(--plum); color: rgb(255, 255, 255); border-radius: 100px; padding: 0.6rem 1.5rem; font-size: 0.82rem; font-weight: 600; text-decoration: none; transition: 0.2s; display: inline-block; }

.pagination-btn:hover { background: var(--rose); transform: translateY(-1px); }

@media (max-width: 900px) {
  .article-grid { grid-template-columns: repeat(2, 1fr); }
}

@media (max-width: 600px) {
  .article-grid { grid-template-columns: 1fr; }
}

.article-layout { grid-template-columns: 1fr 280px; align-items: start; gap: 3rem; max-width: 1200px; margin: 0px auto; padding: 1rem clamp(1rem, 5vw, 4rem) 4rem; display: grid; }

.article-main { min-width: 0px; }

.article-header { margin-bottom: 2rem; }

.article-header h1 { color: var(--plum-dark); margin-bottom: 0.8rem; font-family: "Cormorant Garamond", serif; font-size: clamp(1.8rem, 4vw, 2.5rem); line-height: 1.15; }

.article-meta { color: var(--text-mid); align-items: center; gap: 1rem; margin-bottom: 1.5rem; font-size: 0.82rem; display: flex; }

.article-meta .date { color: var(--text-mid); }

.article-meta .author { color: var(--rose); font-weight: 600; }

.article-hero-img { object-fit: cover; border-radius: 12px; width: 100%; height: auto; max-height: 420px; margin-bottom: 1.5rem; }

.author-section-card { background: rgb(255, 255, 255); border: 1px solid rgba(74, 25, 66, 0.08); border-radius: 12px; align-items: center; gap: 1.2rem; margin-top: 3rem; padding: 1.5rem; display: flex; }

.author-section-card .author-avatar { background: linear-gradient(135deg, var(--plum), var(--rose)); color: rgb(255, 255, 255); border-radius: 50%; flex-shrink: 0; justify-content: center; align-items: center; width: 56px; height: 56px; font-family: "Cormorant Garamond", serif; font-size: 1.4rem; font-weight: 700; display: flex; }

.author-section-card .author-info h3 { color: var(--plum-dark); margin-bottom: 0.2rem; font-size: 1rem; font-weight: 700; }

.author-section-card .author-info p { color: var(--text-mid); font-size: 0.82rem; line-height: 1.5; }

.article-sidebar { position: sticky; top: 80px; }

.table-of-contents { background: rgb(255, 255, 255); border: 1px solid rgba(74, 25, 66, 0.06); border-radius: 12px; margin-bottom: 1.5rem; padding: 1.25rem; }

.table-of-contents h3 { color: var(--plum-dark); margin-bottom: 0.8rem; font-family: "Cormorant Garamond", serif; font-size: 1rem; font-weight: 700; }

.toc-list { list-style: none; }

.toc-list li { margin-bottom: 0.4rem; }

.toc-list a { color: var(--text-mid); border-left: 2px solid rgba(0, 0, 0, 0); padding: 3px 0px 3px 10px; font-size: 0.78rem; line-height: 1.4; text-decoration: none; transition: 0.2s; display: block; }

.toc-list a:hover { color: var(--rose); border-left-color: var(--rose); }

.related-articles { background: rgb(255, 255, 255); border: 1px solid rgba(74, 25, 66, 0.06); border-radius: 12px; padding: 1.25rem; }

.related-articles h3 { color: var(--plum-dark); margin-bottom: 0.8rem; font-family: "Cormorant Garamond", serif; font-size: 1rem; font-weight: 700; }

.related-item { border-bottom: 1px solid rgba(74, 25, 66, 0.04); align-items: flex-start; gap: 0.75rem; padding: 0.6rem 0px; text-decoration: none; transition: 0.2s; display: flex; }

.related-item:last-child { border-bottom-width: medium; border-bottom-style: none; border-bottom-color: currentcolor; }

.related-item:hover { opacity: 0.8; }

.related-item img { object-fit: cover; border-radius: 6px; flex-shrink: 0; width: 64px; height: 42px; }

.related-item p { color: var(--plum-dark); font-size: 0.78rem; font-weight: 500; line-height: 1.4; }

@media (max-width: 1024px) {
  .article-layout { grid-template-columns: 1fr; }
  .article-sidebar { position: static; }
}

