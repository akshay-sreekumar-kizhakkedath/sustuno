# Supabase (required)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server port (optional, defaults to 5000)
PORT=5000

# Data file paths (optional, defaults to bundled data/ directory)
# KB_MASTER_PATH=/path/to/master_knowledge_base.json
# RULE_BASE_PATH=/path/to/rule_base.json
# RECIPES_FILE_PATH=/path/to/Standard_Recipes_Master_Dataset.json
# KB_SOURCE_DIR=/path/to/source_json/

# ML model directory (optional, only needed for shade prediction ML)
# ML_DIR_PATH=/path/to/ml

# CORS origin (optional, defaults to * for development)
# CORS_ORIGIN=https://your-frontend.pages.dev

# Demo model mode (optional, set to 1 to enable)
# SUSTUNO_DEMO_MODEL=1
